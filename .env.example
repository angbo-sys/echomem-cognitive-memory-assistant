# Copy this file to .env and fill in your own values.
# Runtime resolution order is: process environment > .env > config/settings.toml.
# Runtime code should read API settings only through config.load_config().

# Primary LLM routing
LLM_PROVIDER=mimo
LLM_MODEL=mimo-v2.5-pro
LLM_TIMEOUT=30
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95

# MiMo
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_USE_API_KEY_HEADER=false

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Qwen / DashScope
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/api/v1

# Ollama local runtime
OLLAMA_BASE_URL=http://localhost:11434

# Memory analysis model routing: mimo / deepseek
MEMORY_ANALYSIS_PROVIDER=mimo
MEMORY_ANALYSIS_MODEL=mimo-v2.5-pro
MEMORY_ANALYSIS_BASE_URL=
MEMORY_ANALYSIS_TIMEOUT=20
MEMORY_ANALYSIS_USE_API_KEY_HEADER=false

# Retrieval
RETRIEVAL_BACKEND=chroma
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_TOP_K=5
RETRIEVAL_DECAY_LAMBDA=0.05

# Memory frameworks
MEMORY_ENABLE_MEM0=true
MEMORY_ENABLE_LLAMAINDEX_MEMORY=true
MEMORY_ENABLE_COGNEE=true
MEM0_API_KEY=
LLAMA_CLOUD_API_KEY=
COGNEE_API_KEY=
COGNEE_BASE_URL=
COGNEE_DATASET_NAME=echomem
LLAMAINDEX_TOKEN_LIMIT=30000
LLAMAINDEX_CLOUD_MODE=true
COGNEE_CLOUD_MODE=true
